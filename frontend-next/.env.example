# Server-side only. Injected into /api/* requests by middleware.ts.
# Never use NEXT_PUBLIC_ for this value — it must not reach the browser.
API_KEY=dev-admin-key

# Public URL of the backend API. Required in production; defaults to
# http://localhost:8000 in dev. Set this to https://api.yourdomain.com
# (or the Render / Fly URL) before running `next build` for production.
API_URL=http://localhost:8000

# Exposed to the browser so client-side fetch calls (e.g. the merchant
# sandbox simulator) can hit the API directly. Keep these two in sync.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
