# Local Postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/recovery

# mock (dev/test only — refused in production) | openrouter
LLM_PROVIDER=mock
# Model-tier routing (OpenRouter model slugs). Frontier runs diagnose/select_action.
MODEL_FRONTIER=minimax/minimax-m3:free
MODEL_SMALL=minimax/minimax-m3:free

# OpenRouter (LLM_PROVIDER=openrouter) — NEVER put real keys here.
# Secrets belong in a secret manager (AWS SM / Vault); this file holds placeholders only.
OPENROUTER_API_KEY=<set-via-secret-manager>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=30
# Optional attribution headers sent to OpenRouter (app/agent/llm.py)
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=

# ---- LLM fallback (optional) ----
# When OPENROUTER_API_KEY returns 429 or the request fails twice, the
# secondary OpenAI-compatible provider is consulted. Configure both, or
# leave both empty to disable the fallback path. NVIDIA's integrate.api
# endpoint works out of the box; any OpenAI-compatible host will.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_SMALL_MODEL=meta/llama-3.3-70b-instruct

# Dev-only escape hatch: console/mock adapters raise at use-time unless this is true.
# Production refuses mock adapters regardless of this flag (see app/main.py).
ALLOW_MOCK_ADAPTERS=false

ENVIRONMENT=dev

# ---- Outbound email ----
# console = dev/test echo adapter (refused in prod). smtp | resend | sendgrid | mailgun in production.
EMAIL_PROVIDER=console
EMAIL_FROM=recovery@yourdomain.com
# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Resend / SendGrid / Mailgun
RESEND_API_KEY=
SENDGRID_API_KEY=
# Mailgun (EMAIL_PROVIDER=mailgun) — all four vars are required by preflight
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
# EU domains: https://api.eu.mailgun.net ; US (default): https://api.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net
# Inbound replies (Phase C): Mailgun console -> Receiving -> webhook signing key
MAILGUN_WEBHOOK_SIGNING_KEY=

# ---- Payments (Razorpay) ----
# console = dev/test echo adapter (refused in prod). razorpay for TEST or LIVE mode.
# TEST MODE: use the rzp_test_... key pair from Dashboard -> API Keys (Test).
# LIVE MODE: rzp_live_... keys; preflight refuses anything else.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=<set-via-secret-manager>
RAZORPAY_KEY_SECRET=<set-via-secret-manager>
# Webhook signing secret (Razorpay dashboard -> Webhooks). Also accepts PAYMENT_WEBHOOK_SECRET.
RAZORPAY_WEBHOOK_SECRET=
# Per-request HTTP timeout for Razorpay API calls (seconds)
RAZORPAY_TIMEOUT_S=15

# ---- Auth (P0) ----
# Comma-separated entries of "<secret>:<scope1,scope2>". Secrets must be
# 16+ chars in dev, 32+ recommended in prod. Preflight catches short
# secrets and dev placeholders.
API_KEYS=change-me-admin-key-please-rotate:admin,change-me-run-key-please-rotate:run,read,change-me-read-key-please-rotate:read

# Explicit CORS allowlist (comma-separated origins) — must be https in prod.
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests/minute per API key or client IP)
RATE_LIMIT_PER_MINUTE=120

# Max request body size in bytes (default 64 KB)
MAX_BODY_BYTES=65536

# Payment webhook HMAC secret (required for POST /webhooks/payment)
PAYMENT_WEBHOOK_SECRET=

# Runtime kill switch for all outbound write tools (B3 rollback flag).
# Set to false to park all sends instantly without redeploying.
WRITE_TOOLS_ENABLED=true

# Outcome poller interval in seconds (worker: python -m app.workers.outcome_poller [interval])
POLL_INTERVAL_S=30

# Webhook-fallback reconciliation window (seconds). If a webhook hasn't
# produced a payment_event row this long after a payment link was sent,
# the worker queries the gateway directly for that link.
POLL_FALLBACK_AFTER_S=900
